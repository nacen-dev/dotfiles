#!/usr/bin/env bash
#
# Reject commits that stage likely secrets.
# Bypass for a false positive with: git commit --no-verify

set -euo pipefail

patterns=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'sk-[A-Za-z0-9]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  "(api[_-]?key|secret|token|password|passwd)[\"' ]*[:=][\"' ]*[A-Za-z0-9/+_-]{16,}"
)

status=0

while IFS= read -r file; do
  [ -f "$file" ] || continue
  for re in "${patterns[@]}"; do
    if matches=$(grep -EnI -i -- "$re" "$file" 2>/dev/null); then
      printf 'secret-scan: %s\n' "$file" >&2
      printf '%s\n' "$matches" >&2
      status=1
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Refusing to commit: potential secret(s) above." >&2
  echo "Fix the file, or bypass with: git commit --no-verify" >&2
fi

exit "$status"

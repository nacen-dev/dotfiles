# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export GOPATH=$HOME/go
export GOROOT=/usr/local/go
export PATH=$PATH:$GOROOT/bin:$GOPATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

COMPLETION_WAITING_DOTS="true"

# HIST_STAMPS="mm/dd/yyyy"

plugins=(git nvm) 

source $ZSH/oh-my-zsh.sh

alias python="python3"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/home/nacen/google-cloud-sdk/path.zsh.inc' ]; then . '/home/nacen/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/home/nacen/google-cloud-sdk/completion.zsh.inc' ]; then . '/home/nacen/google-cloud-sdk/completion.zsh.inc'; fi

# Turso
export PATH="$PATH:/home/nacen/.turso"
export EDITOR="micro"

# Minikube
export MINIKUBE_HOME=$HOME/.minikube

. "$HOME/.local/bin/env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# opencode
export PATH=/home/nacen/.opencode/bin:$PATH

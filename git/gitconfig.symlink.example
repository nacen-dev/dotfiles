# Sample gitconfig
#

[user]
        name = AUTHORNAME
        email = AUTHOREMAIL
[init]
        defaultBranch = main
[credential]
        helper = GIT_CREDENTIAL_HELPER
[alias]
        co = checkout
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        # Personal preference; these dotfiles install micro, but any editor works.
        editor = vim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple